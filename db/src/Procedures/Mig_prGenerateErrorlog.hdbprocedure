PROCEDURE "Mig_prGenerateErrorlog"(
    IN SR_NO NVARCHAR(50),
    PAYLOAD NVARCHAR(5000),
    SRVNAME NVARCHAR(250),
    ERROR NVARCHAR(1000)
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
AS
BEGIN
   INSERT INTO "MIG_T_INC_ERRLOG" (SR_NO, PAYLOAD, SRVNAME, ERROR) VALUES (SR_NO, PAYLOAD, SRVNAME, ERROR);
END